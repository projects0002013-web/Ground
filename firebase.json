{
  "functions": [
    {
      "source": "functions",
      "codebase": "ground",
      "predeploy": ["npm run build:catalog"]
    }
  ],
  "firestore": { "rules": "firestore.rules" },
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      "**/.*",
      "node_modules/**",
      "functions/**",
      "scripts/**",
      "tests/**",
      "docs/**",
      "package*.json",
      "AGENTS.md",
      "README.md",
      "firestore.rules",
      "*-debug.log"
    ],
    "headers": [
      {
        "source": "/sw.js",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      },
      {
        "source": "/js/firebase-config.js",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      }
    ]
  },
  "emulators": {
    "auth": { "port": 9099 },
    "firestore": { "port": 8080 },
    "functions": { "port": 5001 },
    "ui": { "enabled": false },
    "singleProjectMode": true
  }
}
