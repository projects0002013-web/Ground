{
  "name": "ground",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "build:firebase": "node scripts/build-firebase.mjs",
    "test": "node --test tests/*.test.cjs",
    "test:firebase": "npm run build:rules && firebase emulators:exec --project demo-ground --only auth,firestore 'node --test tests/firebase/*.test.cjs'",
    "test:browser": "python3 tests/browser_smoke.py",
    "build:rules": "node scripts/build-rules.cjs"
  },
  "devDependencies": {
    "firebase": "12.4.0",
    "esbuild": "0.25.10",
    "firebase-tools": "14.18.0",
    "@firebase/rules-unit-testing": "5.0.0"
  }
}
