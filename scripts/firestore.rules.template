// Generated by npm run build:rules. Free Spark plan: no Cloud Functions.
// Rules protect account isolation and bounded, single rewards. They cannot prove
// a learner really answered correctly: scoring occurs in the browser.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) { return request.auth != null && request.auth.uid == uid; }
    function metadata(key) { return (/* CATALOG */).get(key, null); }
    function settingsValid(data) {
      return data.selectedGrade in ['7','8','9','10','11','ent','olympiad']
        && data.layout in ['auto','laptop','phone']
        && data.nickname is string && data.nickname.size() <= 40
        && data.onboarded is bool
        && data.bookPage is int && data.bookPage >= 0 && data.bookPage < 4
        && data.scanPage in [47,48]
        && data.bookRead is list && data.bookRead.size() <= 4
        && data.bookRead.toSet().hasOnly([0,1,2,3]);
    }
    function profileValid(data, uid) {
      return data.keys().hasAll(['uid','createdAt','updatedAt','xp','genes','level','streak','revision','completed','days'])
        && data.keys().hasOnly(['uid','displayName','email','photoURL','nickname','selectedGrade','layout','onboarded','bookRead','bookPage','scanPage','xp','genes','level','streak','lastLessonDate','completed','completedLessons','completedRoadLessons','completedExams','activityHistory','days','courseVersions','revision','lastAttemptId','createdAt','updatedAt'])
        && data.uid == uid
        && data.displayName is string && data.displayName.size() <= 200
        && data.email is string && data.email.size() <= 320
        && data.photoURL is string && data.photoURL.size() <= 2048
        && data.createdAt is timestamp && data.updatedAt == request.time
        && data.xp is int && data.xp >= 0 && data.xp <= 1000000
        && data.genes is int && data.genes >= 0 && data.genes <= 1000000
        && data.level is int && data.level == math.floor(data.xp / 100.0) + 1
        && data.revision is int && data.revision >= 0 && data.revision <= 1000000
        && data.completed is map && data.completed.size() <= 100
        && data.days is list && data.days.size() <= 36600
        && data.streak is int && data.streak >= 0 && data.streak <= data.days.size()
        && data.completedLessons is list && data.completedLessons.toSet() == data.completed.keys().toSet()
        && data.completedRoadLessons is list && data.completedRoadLessons.size() <= 100
        && data.completedExams is list && data.completedExams.size() <= 100
        && data.activityHistory is list && data.activityHistory.size() <= 50
        && data.courseVersions is map
        && settingsValid(data);
    }
    function initialProfile(data,uid) {
      return profileValid(data,uid)
        && data.createdAt == request.time && data.xp == 0 && data.genes == 0
        && data.level == 1 && data.streak == 0 && data.revision == 0
        && data.lastAttemptId == null && data.lastLessonDate == null
        && data.completed.size() == 0 && data.days.size() == 0
        && data.completedExams.size() == 0 && data.activityHistory.size() == 0;
    }
    function resultValid(result) {
      let info = metadata(result.key);
      return info != null
        && result.attemptId is string && result.attemptId.matches('^[a-zA-Z0-9_-]{16,100}$')
        && result.kind == info.kind && result.courseVersion == info.version
        && result.answers is list && result.answers.size() <= info.total
        && result.total is int && result.total >= 0 && result.total <= 40
        && result.total == (info.kind == 'practice' ? result.answers.size() : info.total)
        && result.correct is int && result.correct >= 0 && result.correct <= result.answers.size()
        && result.percent == (result.total == 0 ? 0 : math.round(result.correct * 100.0 / result.total))
        && result.passed == (result.total > 0 && result.correct >= result.total * 0.7)
        && result.completedAt is string && result.completedAt.size() <= 40
        && result.day is string && result.day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }
    function progressUpdate(uid,data) {
      let id = data.lastAttemptId;
      let path = /databases/$(database)/documents/users/$(uid)/attempts/$(id);
      let result = getAfter(path).data.result;
      let info = metadata(result.key);
      let award = result.passed && result.kind != 'practice' && !(result.key in resource.data.completed);
      return id is string && id.matches('^[a-zA-Z0-9_-]{16,100}$') && !exists(path)
        && result.attemptId == id && resultValid(result)
        && data.revision == resource.data.revision + 1
        && data.createdAt == resource.data.createdAt
        && data.diff(resource.data).affectedKeys().hasOnly(['xp','genes','level','streak','lastLessonDate','completed','completedLessons','completedRoadLessons','completedExams','activityHistory','days','courseVersions','revision','lastAttemptId','updatedAt'])
        && (info.previous == null || info.previous in resource.data.completed)
        && (info.kind != 'book' || resource.data.bookRead.size() == 4)
        && result.rewardXP == (award ? info.xp : 0)
        && result.rewardGenes == (award ? info.genes : 0)
        && data.xp == resource.data.xp + result.rewardXP
        && data.genes == resource.data.genes + result.rewardGenes
        && data.completed.diff(resource.data.completed).affectedKeys().hasOnly([result.key])
        && (result.passed && result.kind != 'practice'
          ? result.key in data.completed && data.completed[result.key].percent >= result.percent
            && data.completed[result.key].percent <= 100
          : data.completed == resource.data.completed)
        && data.days.toSet().hasAll(resource.data.days.toSet());
    }
    match /users/{uid} {
      allow read: if owner(uid);
      allow create: if owner(uid) && initialProfile(request.resource.data,uid);
      allow delete: if false;
      allow update: if owner(uid) && profileValid(request.resource.data,uid)
        && (request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName','email','photoURL','selectedGrade','layout','nickname','onboarded','bookRead','bookPage','scanPage','updatedAt'
        ]) || progressUpdate(uid,request.resource.data));
      match /attempts/{id} {
        allow read: if owner(uid);
        allow create: if owner(uid)
          && request.resource.data.keys().hasOnly(['key','result','createdAt'])
          && request.resource.data.createdAt == request.time
          && request.resource.data.key == request.resource.data.result.key
          && request.resource.data.result.attemptId == id
          && resultValid(request.resource.data.result)
          && getAfter(/databases/$(database)/documents/users/$(uid)).data.lastAttemptId == id
          && getAfter(/databases/$(database)/documents/users/$(uid)).data.revision
            == get(/databases/$(database)/documents/users/$(uid)).data.revision + 1;
        allow update, delete: if false;
      }
    }
    match /{document=**} { allow read, write: if false; }
  }
}
